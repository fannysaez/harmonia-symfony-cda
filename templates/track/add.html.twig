{% extends 'base.html.twig' %}

{% block title %}Ajouter un morceau{% endblock %}

{% block body %}

    <nav aria-label="breadcrumb" class="mb-3 mt-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_albums') }}">Albums</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_album_show', {id: album.id}) }}">{{ album.title }}</a></li>
            <li class="breadcrumb-item active">Ajouter un morceau</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-4">
                        <i class="bi bi-plus-circle me-2 text-warning"></i>Ajouter un morceau
                    </h4>
                    <p class="text-muted mb-4">Album : <strong>{{ album.title }}</strong></p>

                    {{ form_start(form) }}

                    <div class="mb-3">
                        <label class="form-label">Titre</label>
                        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Durée (en secondes)</label>
                        {{ form_widget(form.duration, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Numéro de piste</label>
                        {{ form_widget(form.trackNumber, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Genres</label>
                        {{ form_widget(form.genres, {'attr': {'class': 'form-select'}}) }}
                    </div>

                    <div class="mb-4 form-check">
                        {{ form_widget(form.isExplicit, {'attr': {'class': 'form-check-input'}}) }}
                        <label class="form-check-label">Contenu explicite</label>
                    </div>

                    <button type="submit" class="btn btn-orange w-100">
                        <i class="bi bi-save me-1"></i>Enregistrer
                    </button>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
