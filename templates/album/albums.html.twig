                    </div>
                    <div class="card-footer text-muted small d-flex justify-content-between align-items-center">
                        {{ single.releaseDate|date('Y') }}
                        <a href="{{ path('app_album_show', {id: single.id}) }}" class="btn btn-sm btn-outline-primary">Voir l'album</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun single trouvé.</p>
        {% endfor %}
    </div>

{% endblock %}
