                        {{ ep.releaseDate|date('Y') }}
                        <a href="{{ path('app_album_show', {id: ep.id}) }}" class="btn btn-sm btn-outline-primary">Voir l'album</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun EP trouvé.</p>
        {% endfor %}
    </div>

    <h1 class="mb-4" id="singles">Les Singles</h1>
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
        {% for single in singles %}
            <div class="col">
