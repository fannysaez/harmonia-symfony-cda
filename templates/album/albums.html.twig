{% extends 'base.html.twig' %}
{% block title %}Albums{% endblock %}
{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">
            <i class="bi bi-disc me-2 text-warning"></i>Albums
        </h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_album_add') }}" class="btn btn-orange">
                <i class="bi bi-plus-circle me-1"></i>Ajouter un album
            </a>
        {% endif %}
    </div>

    <ul class="nav nav-tabs mb-4" id="albumTabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#albums">Albums</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#ep">EP</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#singles">Singles</a>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="albums">
            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
                {% for album in albums %}
                    <div class="col">
                        {% include 'component/album-card.html.twig' with {album: album} %}
                    </div>
                {% else %}
                    <p>Aucun album trouvé.</p>
                {% endfor %}
            </div>
            {% if totalPagesAlbum > 1 %}
                <nav class="d-flex justify-content-center mb-4">
                    <ul class="pagination">
                        {% for i in 1..totalPagesAlbum %}
                            <li class="page-item {% if i == pageAlbum %}active{% endif %}">
                                <a class="page-link" href="{{ path('app_albums', {pageAlbum: i}) }}">{{ i }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </div>

        <div class="tab-pane fade" id="ep">
            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
                {% for ep in EP %}
                    <div class="col">
                        {% include 'component/album-card.html.twig' with {album: ep} %}
                    </div>
                {% else %}
                    <p>Aucun EP trouvé.</p>
                {% endfor %}
            </div>
            {% if totalPagesEP > 1 %}
                <nav class="d-flex justify-content-center mb-4">
                    <ul class="pagination">
                        {% for i in 1..totalPagesEP %}
                            <li class="page-item {% if i == pageEP %}active{% endif %}">
                                <a class="page-link" href="{{ path('app_albums', {pageEP: i}) }}">{{ i }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </div>

        <div class="tab-pane fade" id="singles">
            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
                {% for single in singles %}
                    <div class="col">
                        {% include 'component/album-card.html.twig' with {album: single} %}
                    </div>
                {% else %}
                    <p>Aucun single trouvé.</p>
                {% endfor %}
            </div>
            {% if totalPagesSingle > 1 %}
                <nav class="d-flex justify-content-center mb-4">
                    <ul class="pagination">
                        {% for i in 1..totalPagesSingle %}
                            <li class="page-item {% if i == pageSingle %}active{% endif %}">
                                <a class="page-link" href="{{ path('app_albums', {pageSingle: i}) }}">{{ i }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </div>
    </div>

{% endblock %}
