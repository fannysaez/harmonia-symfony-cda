{% extends 'base.html.twig' %}

{% block title %}Modifier la playlist{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4 text-center">
                    <i class="bi bi-music-note-list me-2 text-warning"></i>Modifier la playlist
                </h1>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}

                {{ form_start(form) }}
                    <div class="mb-3">
                        <label class="form-label">Nom de la playlist</label>
                        {{ form_widget(form.name) }}
                    </div>
                    <div class="d-grid mb-2">
                        <button class="btn btn-orange" type="submit">Enregistrer</button>
                    </div>
                    <div class="text-center">
                        <a href="{{ path('app_profil') }}" class="text-muted small">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
