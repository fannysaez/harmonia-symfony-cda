<div class="card h-100 shadow-sm position-relative">
    <img src="{{ asset('uploads/' ~ album.coverImage) }}" class="card-img-top" alt="{{ album.title }}" style="height: 220px; object-fit: cover;">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <h5 class="card-title mb-0">{{ album.title }}</h5>
            <span class="badge bg-secondary ms-2">{{ album.type }}</span>
        </div>
        <p class="card-text text-muted mb-1">
            <i class="bi bi-person me-1"></i>{{ album.artist.stageName }}
        </p>
        <p class="card-text small text-muted">
            <i class="bi bi-music-note me-1"></i>{{ album.tracks|length }} morceaux
        </p>
    </div>
    <div class="card-footer text-muted small d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar me-1"></i>{{ album.releaseDate|date('Y') }}</span>
        <div class="d-flex gap-2">
            <a href="{{ path('app_album_show', {id: album.id}) }}" class="btn btn-sm btn-outline-orange">
                <i class="bi bi-eye"></i>
            </a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_album_edit', {id: album.id}) }}" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil"></i>
                </a>
            {% endif %}
        </div>
    </div>
</div>
