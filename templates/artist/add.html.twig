{% extends 'base.html.twig' %}

{% block title %}Ajouter un artiste{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4 text-center">
                    <i class="bi bi-person-plus me-2 text-warning"></i>Ajouter un artiste
                </h1>

                {{ form_start(form) }}
                    <div class="mb-3">
                        <label class="form-label">Nom de scène</label>
                        {{ form_widget(form.stageName, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Biographie</label>
                        {{ form_widget(form.biography, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Pays</label>
                        {{ form_widget(form.country, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="d-grid">
                        <button class="btn btn-orange" type="submit">Ajouter</button>
                    </div>
                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>
{% endblock %}
