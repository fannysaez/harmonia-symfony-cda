{% extends 'base.html.twig' %}

{% block title %}Liste des artistes{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold mb-0">Artistes</h2>
        <div class="d-flex gap-2">
            </a>
            <a href="{{ path('app_artist_add') }}" class="btn btn-warning fw-semibold">
                <i class="bi bi-person-plus-fill me-1"></i> Ajouter
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:16px;">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nom de scène</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for artist in artists %}
                        <tr>
                            <td class="ps-4 fw-semibold">{{ artist.stageName }}</td>
                            <td class="text-end pe-4">
                                <a href="{{ path('app_artist_show', {id: artist.id}) }}" class="btn btn-sm btn-outline-secondary me-1" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_artist_edit', {id: artist.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">Aucun artiste pour le moment.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
