{% extends 'base.html.twig' %}
{% block title %}Genres{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h1>Genres</h1>
    <a href="{{ path('app_genre_add') }}" class="btn btn-orange">+ Ajouter</a>
</div>
<table class="table table-hover">
    <thead>
        <tr><th>Nom</th><th>Couleur</th><th>Actions</th></tr>
    </thead>
    <tbody>
    {% for genre in genres %}
        <tr>
            <td>{{ genre.name }}</td>
            <td><span class="badge" style="background-color: {{ genre.color }}">{{ genre.color }}</span></td>
            <td class="d-flex gap-2">
                <a href="{{ path('app_genre_edit', {id: genre.id}) }}" class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-pencil"></i>
                </a>
                <form method="post" action="{{ path('app_genre_remove', {id: genre.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ genre.id) }}">
                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ?')">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="3">Aucun genre.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
