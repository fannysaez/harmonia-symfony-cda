{% extends 'base.html.twig' %}
{% block title %}Ajouter un genre{% endblock %}
{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <h1 class="mb-4">Ajouter un genre</h1>
        {{ form_start(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.color) }}
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-warning">Enregistrer</button>
                <a href="{{ path('app_genre_list') }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
