{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="d-flex">

        {% include 'admin/_sidebar.html.twig' %}

        <div class="flex-grow-1 p-4">

            {# Header #}
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h2
                        class="fw-bold mb-0"
                        id="greeting"
                        data-name="{{ app.user.firstname ?? app.user.pseudo }}"
                    ></h2>
                    <p class="text-muted mb-0 small" id="current-date"></p>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_artist_add') }}" class="btn btn-warning fw-semibold btn-sm">
                        <i class="bi bi-person-plus-fill me-1"></i> Ajouter un artiste
                    </a>
                    <a href="{{ path('app_album_add') }}" class="btn btn-outline-secondary fw-semibold btn-sm">
                        <i class="bi bi-plus-circle me-1"></i> Ajouter un album
                    </a>
                </div>
            </div>

            {# Stat cards #}
            <div class="row g-3 mb-4">
                <div class="col-md-3 fade-up">
                    <div class="card stat-card border-0 text-white h-100" style="background: linear-gradient(135deg,#f97316,#fb923c); border-radius:16px;">
                        <div class="card-body d-flex align-items-center justify-content-between p-4">
                            <div>
                                <p class="mb-1 fw-semibold" style="opacity:.85; font-size:.85rem; letter-spacing:.05em; text-transform:uppercase;">Artistes</p>
                                <h2 class="fw-bold mb-0 display-5" data-counter="{{ totalArtists }}">0</h2>
                            </div>
                            <i class="bi bi-person-lines-fill stat-icon" style="font-size:3rem;"></i>
                        </div>
                        <div class="card-footer border-0 bg-transparent px-4 pb-3 pt-0">
                            <a href="{{ path('app_artist_list') }}" class="text-white text-decoration-none small">
                                <i class="bi bi-arrow-right-circle me-1"></i>Voir tous les artistes
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 fade-up">
                    <div class="card stat-card border-0 text-white h-100" style="background: linear-gradient(135deg,#8b5cf6,#a78bfa); border-radius:16px;">
                        <div class="card-body d-flex align-items-center justify-content-between p-4">
                            <div>
                                <p class="mb-1 fw-semibold" style="opacity:.85; font-size:.85rem; letter-spacing:.05em; text-transform:uppercase;">Albums</p>
                                <h2 class="fw-bold mb-0 display-5" data-counter="{{ totalAlbums }}">0</h2>
                            </div>
                            <i class="bi bi-disc stat-icon" style="font-size:3rem;"></i>
                        </div>
                        <div class="card-footer border-0 bg-transparent px-4 pb-3 pt-0">
                            <a href="{{ path('app_albums') }}" class="text-white text-decoration-none small">
                                <i class="bi bi-arrow-right-circle me-1"></i>Voir tous les albums
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 fade-up">
                    <div class="card stat-card border-0 text-white h-100" style="background: linear-gradient(135deg,#0ea5e9,#38bdf8); border-radius:16px;">
                        <div class="card-body d-flex align-items-center justify-content-between p-4">
                            <div>
                                <p class="mb-1 fw-semibold" style="opacity:.85; font-size:.85rem; letter-spacing:.05em; text-transform:uppercase;">Tracks</p>
                                <h2 class="fw-bold mb-0 display-5" data-counter="{{ totalTracks }}">0</h2>
                            </div>
                            <i class="bi bi-music-note-list stat-icon" style="font-size:3rem;"></i>
                        </div>
                        <div class="card-footer border-0 bg-transparent px-4 pb-3 pt-0">
                            <span class="text-white small" style="opacity:.75;">
                                <i class="bi bi-info-circle me-1"></i>Total des musiques
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 fade-up">
                    <div class="card stat-card border-0 text-white h-100" style="background: linear-gradient(135deg,#10b981,#34d399); border-radius:16px;">
                        <div class="card-body d-flex align-items-center justify-content-between p-4">
                            <div>
                                <p class="mb-1 fw-semibold" style="opacity:.85; font-size:.85rem; letter-spacing:.05em; text-transform:uppercase;">Playlists</p>
                                <h2 class="fw-bold mb-0 display-5" data-counter="{{ totalPlaylists }}">0</h2>
                            </div>
                            <i class="bi bi-collection-play stat-icon" style="font-size:3rem;"></i>
                        </div>
                        <div class="card-footer border-0 bg-transparent px-4 pb-3 pt-0">
                            <a href="{{ path('app_playlist_index') }}" class="text-white text-decoration-none small">
                                <i class="bi bi-arrow-right-circle me-1"></i>Voir mes playlists
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# Répartition par type #}
            {% if albumChartLabels is defined and albumChartLabels|length > 0 %}
                <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart-fill text-warning me-2"></i>Répartition par type</h5>
                        {% for i, label in albumChartLabels %}
                            {% set count = albumChartData[i] %}
                            {% set pct = totalAlbums > 0 ? (count / totalAlbums * 100)|round : 0 %}
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small fw-semibold mb-1">
                                    <span>{{ label }}</span>
                                    <span class="text-muted">{{ count }}</span>
                                </div>
                                <div class="bg-light rounded" style="height:10px;">
                                    <div class="type-bar bg-warning" style="--w: {{ pct }}%;"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# Last albums table #}
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-warning me-2"></i>Derniers albums ajoutés</h5>
                    {% if lastAlbums is defined and lastAlbums|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Titre</th>
                                        <th>Artiste</th>
                                        <th>Type</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for album in lastAlbums %}
                                        <tr>
                                            <td class="fw-semibold">{{ album.title }}</td>
                                            <td class="text-muted">{{ album.artist.stageName }}</td>
                                            <td><span class="badge bg-warning text-dark">{{ album.type }}</span></td>
                                            <td class="text-end">
                                                <a href="{{ path('app_album_show', {id: album.id}) }}" class="btn btn-sm btn-outline-secondary me-1" title="Voir">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="{{ path('app_album_edit', {id: album.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">Aucun album pour le moment.</p>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}
