{% extends 'base.html.twig' %}

{% block title %}Gestion des albums{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="d-flex">

        {% include 'admin/_sidebar.html.twig' %}

        <div class="flex-grow-1 p-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-disc text-warning me-2"></i>Albums
                </h2>
                <a href="{{ path('app_album_add') }}" class="btn btn-sm btn-orange">
                    <i class="bi bi-plus-circle me-1"></i>Ajouter un album
                </a>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Titre</th>
                                    <th>Artiste</th>
                                    <th>Type</th>
                                    <th>Morceaux</th>
                                    <th>Année</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for album in albums %}
                                    <tr>
                                        <td class="fw-semibold">{{ album.title }}</td>
                                        <td class="text-muted">{{ album.artist.stageName }}</td>
                                        <td><span class="badge bg-warning text-dark">{{ album.type }}</span></td>
                                        <td>{{ album.tracks|length }}</td>
                                        <td>{{ album.releaseDate|date('Y') }}</td>
                                        <td class="text-end">
                                            <a href="{{ path('app_album_show', {id: album.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="{{ path('app_album_edit', {id: album.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3 d-flex justify-content-center">
                        {% if totalPages > 1 %}
                            <nav class="d-flex justify-content-center mt-3">
                                <ul class="pagination">
                                    {% for i in 1..totalPages %}
                                        <li class="page-item {% if i == page %}active{% endif %}">
                                            <a class="page-link" href="{{ path('app_admin_albums', {page: i}) }}">{{ i }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </nav>
                        {% endif %}                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}
