{% extends 'base.html.twig' %}
{% block title %}Tracks{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}
{% block body %}
<div class="d-flex">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="flex-grow-1 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Tracks</h2>
        </div>
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-4">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Titre</th>
                            <th>Album</th>
                            <th>Durée</th>
                            <th>Écoutes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for track in tracks %}
                        <tr>
                            <td class="fw-semibold">
                                {{ track.title }}
                                {% if track.isExplicit %}<span class="badge bg-danger ms-1">E</span>{% endif %}
                            </td>
                            <td class="text-muted">{{ track.album.title }}</td>
                            <td>{{ (track.duration / 60)|round(0, 'floor') }}:{{ '%02d'|format(track.duration % 60) }}</td>
                            <td>{{ track.listenCount }}</td>
                            <td class="text-end">
                                <a href="{{ path('app_album_show', {id: track.album.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir album">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_track_edit', {id: track.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">Aucune track.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>

                {% if totalPages > 1 %}
                    <nav class="d-flex justify-content-center mt-3">
                        <ul class="pagination">
                            <li class="page-item {% if page == 1 %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_admin_tracks', {page: page - 1}) }}">«</a>
                            </li>
                            {% for i in 1..totalPages %}
                                <li class="page-item {% if i == page %}active{% endif %}">
                                    <a class="page-link" href="{{ path('app_admin_tracks', {page: i}) }}">{{ i }}</a>
                                </li>
                            {% endfor %}
                            <li class="page-item {% if page == totalPages %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_admin_tracks', {page: page + 1}) }}">»</a>
                            </li>
                        </ul>
                    </nav>
                {% endif %}

            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}
