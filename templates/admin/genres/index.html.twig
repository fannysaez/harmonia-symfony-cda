{% extends 'base.html.twig' %}
{% block title %}Genres - Admin{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}
{% block body %}
<div class="d-flex">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="flex-grow-1 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Genres</h2>
            <a href="{{ path('app_genre_add') }}" class="btn btn-warning fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Ajouter
            </a>
        </div>
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-4">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nom</th>
                            <th>Couleur</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for genre in genres %}
                        <tr>
                            <td class="fw-semibold">{{ genre.name }}</td>
                            <td>
                                <span class="badge" style="background-color: {{ genre.color }}">{{ genre.color }}</span>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_genre_edit', {id: genre.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('app_genre_remove', {id: genre.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ genre.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">Aucun genre.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}
