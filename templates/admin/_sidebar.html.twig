                <i class="bi bi-person-lines-fill text-warning"></i> Artistes
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_admin_albums') }}" class="nav-link text-white d-flex align-items-center gap-2 rounded px-3 py-2" style="transition:.2s;" onmouseover="this.style.background='rgba(253,126,20,.1)';this.style.color='#fd7e14'" onmouseout="this.style.background='transparent';this.style.color='white'">
