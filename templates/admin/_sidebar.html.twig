{# ── Sidebar ── #}
<nav class="d-flex flex-column p-3 text-white" style="width: 240px; min-width: 240px; background: #1a1d21; min-height: calc(100vh - 56px);">
    <div class="text-center mb-4 mt-2">
        <i class="bi bi-speedometer2 fs-1 text-warning"></i>
        <p class="fw-bold mt-1 mb-0" style="font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: #aaa;">Tableau de bord</p>
