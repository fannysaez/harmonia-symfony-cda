{% extends 'base.html.twig' %}
{% block title %}Utilisateurs{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}
{% block body %}
<div class="d-flex">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="flex-grow-1 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Utilisateurs</h2>
        </div>
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-4">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Pseudo</th>
                            <th>Email</th>
                            <th>Rôle</th>
                            <th>Membre depuis</th>
                            <th>Favoris</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="fw-semibold">{{ user.pseudo }}</td>
                            <td class="text-muted">{{ user.email }}</td>
                            <td>
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge bg-danger">Admin</span>
                                {% else %}
                                    <span class="badge bg-secondary">User</span>
                                {% endif %}
                            </td>
                            <td>{{ user.createdAt ? user.createdAt|date('d/m/Y') : '-' }}</td>
                            <td>{{ user.favoriteTracks|length }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">Aucun utilisateur.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}
